<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps the web app running on login, reachable over Tailscale on port 8787.
  Runs the project virtualenv created by `uv sync`. Importing from Messages needs
  Full Disk Access for the real interpreter behind .venv/bin/python; see README.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexandrupopa.joint-expense-tracker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alexandrupopa/.joint-expense-tracker/service-app/.venv/bin/python</string>
    <string>-m</string>
    <string>joint_expense_tracker</string>
    <string>web</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8787</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/alexandrupopa/.joint-expense-tracker/service-app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/alexandrupopa</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/alexandrupopa/.joint-expense-tracker/service-app/launchd/manual-web.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alexandrupopa/.joint-expense-tracker/service-app/launchd/manual-web.err.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
</dict>
</plist>
